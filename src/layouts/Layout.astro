---
interface Props {
	title: string;
	description?: string;
}

const { title, description = "La Paradoja es un thriller psicológico de alto voltaje escrito por Francisco M. López Martínez. Descubre el nacimiento del inspector Álvaro Ayala. ¡Consigue tu ejemplar en Amazon!" } = Astro.props;

// Configuración de SEO y URLs Absolutas
const siteUrl = "https://tebeitos.github.io/francisco-lopez-escritor"; // Cambiar por dominio propio si se adquiere uno
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const socialImageURL = new URL('/portada.jpg', siteUrl);

// Datos estructurados en formato JSON-LD (Schema.org)
const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Book",
      "@id": `${siteUrl}/#book`,
      "name": "La Paradoja",
      "headline": "Un thriller psicológico de alto voltaje",
      "description": "La Paradoja es una novela negra y thriller psicológico donde vas a dudar de cada pista, igual que Álvaro Ayala duda de su propia memoria.",
      "author": {
        "@id": `${siteUrl}/#author`
      },
      "image": socialImageURL.toString(),
      "publisher": {
        "@type": "Organization",
        "name": "Letras del Alma Ediciones"
      },
      "bookEdition": "2ª Edición",
      "genre": "Novela negra / Thriller psicológico",
      "url": siteUrl,
      "workExample": [
        {
          "@type": "Book",
          "bookFormat": "https://schema.org/EBook",
          "potentialAction": {
            "@type": "ReadAction",
            "target": "https://www.amazon.es/Paradoja-%C2%ABthriller%C2%BB-psicol%C3%B3gico-alto-voltaje-ebook/dp/B0G5ZLNPX7?ref_=ast_author_mpb"
          }
        },
        {
          "@type": "Book",
          "bookFormat": "https://schema.org/Paperback",
          "potentialAction": {
            "@type": "ReadAction",
            "target": "https://www.amazon.es/Paradoja-%C2%ABthriller%C2%BB-psicol%C3%B3gico-alto-voltaje-ebook/dp/B0G5ZLNPX7?ref_=ast_author_mpb"
          }
        }
      ]
    },
    {
      "@type": "Person",
      "@id": `${siteUrl}/#author`,
      "name": "Francisco M. López Martínez",
      "description": "Nacido en Gijón en 1980. Diplomado en Trabajo Social y apasionado de la novela policiaca y el thriller, creador del universo del inspector Álvaro Ayala.",
      "sameAs": [
        "https://instagram.com/franciscomlopez.escritor"
      ]
    }
  ]
};
const schemaString = JSON.stringify(schemaData);
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- SEO Meta Tags -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		<meta name="robots" content="index, follow" />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="book" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={socialImageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:site_name" content="Francisco M. López Martínez" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalURL} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageURL} />

		<!-- Google Fonts: Cormorant Garamond for titles, Lora for body -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500&family=Lora:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
		
		<!-- Structured Data (JSON-LD) -->
		<script type="application/ld+json" set:html={schemaString}></script>
	</head>
	<body>
		<!-- Soft background elements simulating mist and mysterious depth -->
		<div class="mist-overlay"></div>
		<div class="labyrinth-glow"></div>
		
		<header class="site-header">
			<div class="header-content">
				<!-- Botón de menú hamburguesa (solo visible en móvil) -->
				<button class="menu-toggle" id="menuToggle" aria-label="Abrir menú">
					<span class="hamburger-bar"></span>
					<span class="hamburger-bar"></span>
					<span class="hamburger-bar"></span>
				</button>

				<a href="/" class="site-logo">
					<span class="logo-main">LA PARADOJA</span>
					<span class="logo-sub">Álvaro Ayala #1</span>
				</a>

				<!-- Menú de navegación de escritorio -->
				<nav class="site-nav">
					<a href="#libro">El Libro</a>
					<a href="#autor">El Autor</a>
					<a href="https://www.amazon.es/dp/8409772949?tag=tebeitos-21" target="_blank" rel="noopener noreferrer" class="nav-buy-btn">Comprar</a>
				</nav>

				<!-- Espaciador simétrico en móvil para centrar el logotipo -->
				<div class="header-right-spacer"></div>
			</div>
		</header>

		<!-- Menú desplegable móvil -->
		<div class="mobile-menu-overlay" id="mobileMenu">
			<nav class="mobile-nav">
				<a href="#libro" class="mobile-nav-link">El Libro</a>
				<a href="#autor" class="mobile-nav-link">El Autor</a>
				<a href="https://www.amazon.es/dp/8409772949?tag=tebeitos-21" target="_blank" rel="noopener noreferrer" class="mobile-buy-btn">Comprar en Amazon</a>
			</nav>
		</div>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="footer-content">
				<div class="footer-brand">
					<p class="footer-title">LA PARADOJA</p>
					<p class="footer-tagline">Un thriller psicológico de alto voltaje</p>
				</div>
				<p class="footer-copyright">
					© {new Date().getFullYear()} Francisco M. López Martínez. Todos los derechos reservados.
				</p>
				<p class="footer-editorial">
					Publicado por <span class="editorial-highlight">Letras del Alma Ediciones</span> • 2ª Edición
				</p>
			</div>
		</footer>
	</body>
</html>

<script>
	const menuToggle = document.getElementById('menuToggle');
	const mobileMenu = document.getElementById('mobileMenu');
	const mobileLinks = document.querySelectorAll('.mobile-nav-link, .mobile-buy-btn');

	if (menuToggle && mobileMenu) {
		const toggleMenu = () => {
			const isActive = menuToggle.classList.toggle('active');
			mobileMenu.classList.toggle('active', isActive);
			// Evita scroll en la página detrás del menú abierto
			document.body.style.overflow = isActive ? 'hidden' : '';
		};

		menuToggle.addEventListener('click', toggleMenu);

		// Cierra el menú al hacer clic en cualquier enlace
		mobileLinks.forEach(link => {
			link.addEventListener('click', () => {
				menuToggle.classList.remove('active');
				mobileMenu.classList.remove('active');
				document.body.style.overflow = '';
			});
		});
	}
</script>

<style is:global>
	:root {
		--color-bg: #0D1B24;      /* Azul noche */
		--color-surface: #1B3A4B; /* Azul petróleo */
		--color-surface-rgb: 27, 58, 75;
		--color-text: #F2EFE9;    /* Blanco hueso */
		--color-text-muted: rgba(242, 239, 233, 0.7);
		--color-accent: #C4B896;  /* Dorado apagado */
		--color-accent-rgb: 196, 184, 150;
		--color-accent-hover: #D7CDAF;
		
		--font-title: 'Cormorant Garamond', Georgia, serif;
		--font-body: 'Lora', Georgia, serif;
		
		--max-width: 1100px;
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		background-color: var(--color-bg);
		color: var(--color-text);
		font-family: var(--font-body);
		line-height: 1.8;
		font-size: 1.1rem;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
		position: relative;
		min-height: 100vh;
		overflow-x: hidden;
		display: flex;
		flex-direction: column;
	}

	/* Background ambient mist */
	.mist-overlay {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: 
			radial-gradient(circle 70vw at 50% -10%, rgba(27, 58, 75, 0.45) 0%, rgba(13, 27, 36, 0) 80%),
			radial-gradient(circle 50vw at 80% 60%, rgba(27, 58, 75, 0.15) 0%, rgba(13, 27, 36, 0) 100%),
			radial-gradient(circle 60vw at -10% 80%, rgba(27, 58, 75, 0.2) 0%, rgba(13, 27, 36, 0) 100%);
		pointer-events: none;
		z-index: -2;
	}

	/* Abstract representation of labyrinth patterns / shadows */
	.labyrinth-glow {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background-image: 
			radial-gradient(circle at center, transparent 30%, rgba(13, 27, 36, 0.95) 90%),
			repeating-radial-gradient(circle at center, rgba(196, 184, 150, 0.008) 0px, rgba(196, 184, 150, 0.008) 1px, transparent 1px, transparent 40px),
			repeating-radial-gradient(circle at center, rgba(27, 58, 75, 0.02) 0px, rgba(27, 58, 75, 0.02) 2px, transparent 2px, transparent 80px);
		pointer-events: none;
		z-index: -1;
		opacity: 0.85;
	}

	/* Typography & Headings */
	h1, h2, h3, h4, h5, h6 {
		font-family: var(--font-title);
		font-weight: 500;
		letter-spacing: 0.02em;
		line-height: 1.2;
		color: var(--color-text);
	}

	p {
		margin-bottom: 1.5rem;
		color: var(--color-text-muted);
	}

	a {
		color: var(--color-accent);
		text-decoration: none;
		transition: color 0.3s ease, border-color 0.3s ease;
	}

	a:hover {
		color: var(--color-accent-hover);
	}

	/* Header */
	.site-header {
		padding: 2rem 2rem;
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		z-index: 95;
	}

	.header-content {
		max-width: var(--max-width);
		margin: 0 auto;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.site-logo {
		display: flex;
		flex-direction: column;
		letter-spacing: 0.15em;
		text-decoration: none;
		z-index: 100;
	}

	.logo-main {
		font-family: var(--font-title);
		font-size: 1.6rem;
		font-weight: 600;
		color: var(--color-text);
		line-height: 1;
	}

	.logo-sub {
		font-size: 0.65rem;
		font-weight: 500;
		color: var(--color-accent);
		margin-top: 0.3rem;
		text-transform: uppercase;
		opacity: 0.9;
	}

	.site-nav {
		display: flex;
		align-items: center;
		gap: 2.5rem;
	}

	.site-nav a:not(.nav-buy-btn) {
		font-family: var(--font-title);
		font-size: 1.15rem;
		color: var(--color-text);
		text-transform: uppercase;
		letter-spacing: 0.1em;
		opacity: 0.8;
		border-bottom: 1px solid transparent;
		padding-bottom: 2px;
	}

	.site-nav a:not(.nav-buy-btn):hover {
		opacity: 1;
		border-color: var(--color-accent);
		color: var(--color-accent);
	}

	.nav-buy-btn {
		font-family: var(--font-title);
		font-size: 1.05rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--color-bg);
		background-color: var(--color-accent);
		padding: 0.6rem 1.8rem;
		border: 1px solid var(--color-accent);
		transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
	}

	.nav-buy-btn:hover {
		background-color: transparent;
		color: var(--color-accent);
	}

	/* Hamburger Toggle Button */
	.menu-toggle {
		display: none;
		background: none;
		border: none;
		cursor: pointer;
		padding: 10px;
		z-index: 100;
		flex-direction: column;
		gap: 6px;
		width: 44px;
		height: 44px;
		justify-content: center;
		align-items: center;
	}

	.hamburger-bar {
		display: block;
		width: 24px;
		height: 2px;
		background-color: var(--color-text);
		transition: transform 0.3s ease, opacity 0.3s ease, background-color 0.3s ease;
	}

	.menu-toggle.active .hamburger-bar:nth-child(1) {
		transform: translateY(8px) rotate(45deg);
		background-color: var(--color-accent);
	}

	.menu-toggle.active .hamburger-bar:nth-child(2) {
		opacity: 0;
	}

	.menu-toggle.active .hamburger-bar:nth-child(3) {
		transform: translateY(-8px) rotate(-45deg);
		background-color: var(--color-accent);
	}

	/* Espaciador para centrar el logo en móvil */
	.header-right-spacer {
		display: none;
	}

	/* Menú desplegable móvil */
	.mobile-menu-overlay {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background-color: rgba(13, 27, 36, 0.98);
		backdrop-filter: blur(12px);
		z-index: 90;
		display: flex;
		justify-content: center;
		align-items: center;
		opacity: 0;
		visibility: hidden;
		transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.4s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.mobile-menu-overlay.active {
		opacity: 1;
		visibility: visible;
	}

	.mobile-nav {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2.2rem;
		width: 80%;
		max-width: 320px;
		transform: translateY(-30px);
		transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.mobile-menu-overlay.active .mobile-nav {
		transform: translateY(0);
	}

	.mobile-nav-link {
		font-family: var(--font-title);
		font-size: 2.2rem;
		color: var(--color-text);
		text-transform: uppercase;
		letter-spacing: 0.12em;
		transition: color 0.3s ease;
	}

	.mobile-nav-link:hover {
		color: var(--color-accent);
	}

	.mobile-buy-btn {
		font-family: var(--font-title);
		font-size: 1.5rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--color-bg);
		background-color: var(--color-accent);
		padding: 0.8rem 2.2rem;
		border: 1px solid var(--color-accent);
		width: 100%;
		text-align: center;
		transition: all 0.3s ease;
		margin-top: 1rem;
	}

	.mobile-buy-btn:hover {
		background-color: transparent;
		color: var(--color-accent);
	}

	/* Main */
	main {
		flex: 1;
		margin-top: 6rem;
	}

	/* Footer */
	.site-footer {
		padding: 5rem 2rem 4rem;
		border-top: 1px solid rgba(196, 184, 150, 0.08);
		background: linear-gradient(to bottom, transparent, rgba(13, 27, 36, 0.8));
		text-align: center;
	}

	.footer-content {
		max-width: var(--max-width);
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.8rem;
	}

	.footer-brand {
		margin-bottom: 0.5rem;
	}

	.footer-title {
		font-family: var(--font-title);
		font-size: 2.2rem;
		color: var(--color-text);
		letter-spacing: 0.12em;
		margin-bottom: 0.3rem;
		line-height: 1;
	}

	.footer-tagline {
		font-family: var(--font-title);
		font-size: 1.1rem;
		font-style: italic;
		color: var(--color-accent);
		letter-spacing: 0.02em;
	}

	.footer-copyright {
		font-size: 0.9rem;
		color: rgba(242, 239, 233, 0.4);
		margin-bottom: 0;
	}

	.footer-editorial {
		font-size: 0.95rem;
		color: rgba(242, 239, 233, 0.6);
		letter-spacing: 0.03em;
		margin-bottom: 0;
	}

	.editorial-highlight {
		color: var(--color-text);
		font-weight: 500;
	}

	/* Responsive design settings */
	@media (max-width: 991px) {
		.site-header {
			padding: 1rem 1.5rem;
			position: fixed;
			background-color: rgba(13, 27, 36, 0.85);
			backdrop-filter: blur(12px);
			border-bottom: 1px solid rgba(196, 184, 150, 0.05);
			z-index: 98;
		}
		
		.header-content {
			display: grid;
			grid-template-columns: 44px 1fr 44px;
			justify-items: center;
			align-items: center;
			width: 100%;
		}

		.site-logo {
			align-items: center;
		}

		.logo-main {
			font-size: 1.4rem;
		}

		.logo-sub {
			font-size: 0.6rem;
		}

		.site-nav {
			display: none; /* Oculta navegación en escritorio */
		}

		.menu-toggle {
			display: flex; /* Muestra el botón de menú */
			grid-column: 1;
			justify-self: start;
		}

		.header-right-spacer {
			display: block;
			width: 44px; /* Simula la anchura del botón de menú para equilibrar */
			grid-column: 3;
		}

		main {
			margin-top: 4.2rem; /* Margen para compensar la cabecera fija */
		}
		
		.footer-title {
			font-size: 1.8rem;
		}
	}
</style>
